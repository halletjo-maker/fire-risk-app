# =============================================================
#  Analyse Boursière — fichier de configuration
#  Copier ce fichier en ".env" (même dossier) puis compléter.
#  Ne JAMAIS committer le fichier .env.
# =============================================================

# --- Actualités ---------------------------------------------
# Clé gratuite : https://newsapi.org/register
NEWSAPI_KEY=ta_cle_ici

# --- Source de secours (optionnelle) ------------------------
# Clé gratuite : https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=ta_cle_ici

# --- Envoi des alertes par mail (SMTP) ----------------------
# Gmail : utiliser un "mot de passe d'application"
#   (Compte Google > Sécurité > Validation en 2 étapes > Mots de passe des applications)
# Outlook : SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_mail@gmail.com
SMTP_PASSWORD=ton_mot_de_passe_app
SMTP_FROM=ton_mail@gmail.com
# true = STARTTLS (port 587) ; false + port 465 = SSL direct
SMTP_USE_TLS=true

# --- Application --------------------------------------------
# Adresse utilisée dans les mails pour le lien "voir l'analyse complète".
# Mettre l'IP de la machine sur le réseau local, ex. http://192.168.1.20:3000
APP_PUBLIC_URL=http://localhost:3000

# Emplacement de la base SQLite (relatif au dossier backend/)
DATABASE_PATH=data/stock_analyzer.db

# Tâches de fond (rafraîchissement watchlists + vérification alertes)
SCHEDULER_ENABLED=true
REFRESH_INTERVAL_MINUTES=15

# Délai minimum (secondes) entre deux requêtes vers un même site scrapé
SCRAPING_DELAY_SECONDS=2

# Origines autorisées pour le frontend (séparées par des virgules).
# "*" = toute machine du réseau local (pratique pour le mobile).
CORS_ORIGINS=*

# Niveau de logs : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
